# Copy this file on the server and fill values there. Do not commit real secrets.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

ARTX_DATA_DIR=/var/lib/artx
ARTX_UPLOADS_DIR=/var/lib/artx/uploads
ARTX_ADMIN_DATA_BACKEND=json
ARTX_AUTH_DATA_BACKEND=json

PUBLIC_APP_URL=https://backstage.artxsd.com
APP_PUBLIC_URL=https://backstage.artxsd.com
SITE_URL=https://backstage.artxsd.com
OAUTH_PUBLIC_BASE_URL=https://backstage.artxsd.com
OAUTH_FRONTEND_URL=https://backstage.artxsd.com
WALLYT_NOTIFY_URL=https://backstage.artxsd.com/api/billing/wallyt/callback

# ── 图片生成：2026-09-12 起全站走腾讯云 VOD 直连，中转站不再提供图片能力 ──
#
# AI_IMAGE_MODEL 必须填 shared/image-models.ts 注册表里的 id。
# 留空即回落到 DEFAULT_IMAGE_MODEL_ID（= vod-og25-sunburst-medium），
# 这是最省心也最不容易随代码演进而失效的写法，因此默认留空。
#
# ⚠️ 曾经的坑：这里原本写死 AI_IMAGE_MODEL=gpt-image-2（中转站型号）。
# 实测该值 normalize 后仍是 "gpt-image-2"，isSupported=false，
# 只能靠「不认识 → 退回全局 fallback 链」才勉强落到 image2.5，
# 语义错误且一旦 fallback 逻辑收紧就会直接出不了图。
AI_IMAGE_MODEL=
# AI_IMAGE_BASE_URL / AI_IMAGE_API_KEY 现在只被中转站文本侧的多模态识图复用，
# 图片生成本身不再读取它们。保留是为了 OCR / 视觉理解链路。
AI_IMAGE_BASE_URL=https://token.bkeel.com/v1

# ── 腾讯云 VOD AIGC：图片生成的唯一通道，三个都缺一不可 ──
#
# ⚠️ 不配置的直接后果（server/image-generation.ts 会抛出）：
#   「图片生成不可用：腾讯 VOD AIGC 凭证未配置
#     （需要 TENCENT_VOD_SID / TENCENT_VOD_SKEY / TENCENT_VOD_SUB_APP_ID）。」
# 即全站所有出图功能 100% 不可用，且没有任何兜底通道。
# SID/SKEY 属于密钥，只写在服务器上；SUB_APP_ID 不是密钥，可直接填。
# TENCENT_VOD_SID=
# TENCENT_VOD_SKEY=
TENCENT_VOD_SUB_APP_ID=1304471873

# ── 文本 / 多模态：仍走中转站 ──
# claude-opus-5 只在 token.bkeel.com 上存在，填 api.openai.com 会 404。
# 必须与 shared/text-models.ts 的 DEFAULT_TEXT_MODEL 保持一致。
AI_TEXT_BASE_URL=https://token.bkeel.com/v1
AI_TEXT_MODEL=claude-opus-5
PICWISH_BASE_URL=https://techsz.aoscdn.com
MEITU_FORMULA_BASE_URL=https://openapi.meitu.com
# 局部重绘 formula 配方 ID（doc/331 固定为 /v1/InPainting/468520，一般无需配置；仅当官方变更时覆盖）
MEITU_INPAINT_TASK=/v1/InPainting/468520
MEITU_INPAINT_TIMEOUT_MS=120000
# 蒙版重绘区向外扩展像素（建议 5-10）；边缘羽化像素（建议 4-8）
MEITU_MASK_EXPAND_PX=6
MEITU_MASK_FEATHER_PX=6

# 参数化擦字引擎（智能文案编辑的擦除通道之一，可选）
#
# 本地开发指向 http://127.0.0.1:8077 的 python 服务（image-text-replace）。
# 生产环境若未部署该服务，**留空即可**，不要照抄 127.0.0.1 ——
# 那会让每次擦字请求都去连服务器本机的 8077 端口，白白等一次连接超时。
#
# 留空后的行为：该通道直接返回 null，擦字改由「美图局部重绘 → 佐糖物体擦除
# → 本地像素擦除」接手，功能不受影响。
# 补充：2026-09-12 起「删除整行」场景本来就绕开引擎直接走本地像素擦除
# （引擎擦净率仅 37.3%，本地 100%），所以引擎缺失只影响改字场景的擦除质量。
TEXT_ENGINE_BASE_URL=

# Secrets belong only on the server:
# AI_IMAGE_API_KEY=
# AI_TEXT_API_KEY=
# 腾讯云 VOD AIGC（图片生成唯一通道，缺失则全站无法出图）
# TENCENT_VOD_SID=
# TENCENT_VOD_SKEY=
# PICWISH_API_KEY=
# ACCESS_KEY=
# SECRET_KEY=
# OAUTH_STATE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# WECHAT_CLIENT_ID=
# WECHAT_CLIENT_SECRET=
# WALLYT_DOMAIN_URL=
# WALLYT_MCH_ID=
# WALLYT_SIGNATURE_KEY=
# WALLYT_WX_APP_ID=
# ADMIN_SESSION_SECRET=
# DATABASE_URL=
