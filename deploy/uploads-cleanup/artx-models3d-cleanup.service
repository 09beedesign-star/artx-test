[Unit]
Description=ArtX 3D canvas model files cleanup (48h retention)
Documentation=删除超过 48 小时的 3D 画布模型文件（/var/lib/artx-shared/uploads/models3d），不做任何备份
After=network-online.target

[Service]
Type=oneshot

# ⚠️ 身份与目录变量必须与 artx-gray-backend.service / artx-uploads-cleanup.service 逐字一致。
User=artx
Group=artx
WorkingDirectory=/opt/artx-gray-backend/current
Environment=NODE_ENV=production
Environment=ARTX_DATA_DIR=/var/lib/artx-gray
Environment=ARTX_UPLOADS_DIR=/var/lib/artx-shared/uploads
EnvironmentFile=-/opt/artx-gray-backend/current/.env.gray
EnvironmentFile=-/opt/artx-gray-backend/.env.gray

ExecStart=/usr/bin/node /opt/artx-gray-backend/current/dist/cleanup-uploads-cli.js --models3d-only

StandardOutput=append:/var/log/artx/uploads-cleanup.log
StandardError=append:/var/log/artx/uploads-cleanup.log
SyslogIdentifier=artx-models3d-cleanup

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/artx-shared/uploads /var/log/artx
UMask=0027
TimeoutStartSec=5min
