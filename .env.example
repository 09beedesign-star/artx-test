AI_IMAGE_API_KEY=your_api_key_here
AI_IMAGE_BASE_URL=https://token.bkeel.com
AI_IMAGE_MODEL=gpt-image-2
AI_TEXT_API_KEY=your_text_api_key_here
AI_TEXT_BASE_URL=https://api.openai.com
AI_TEXT_MODEL=gpt-4o
PICWISH_API_KEY=your_picwish_api_key_here
PICWISH_BASE_URL=https://techsz.aoscdn.com
# PicWish HD enhancement reuses PICWISH_API_KEY and PICWISH_BASE_URL.
# 美图 AI 开放平台「局部重绘」（智能注释 → AI 修改引擎，doc/331）
ACCESS_KEY=your_meitu_access_key_here
SECRET_KEY=your_meitu_secret_key_here
MEITU_FORMULA_BASE_URL=https://openapi.meitu.com
# 局部重绘 formula 配方 ID（doc/331 固定为 /v1/InPainting/468520，一般无需配置；仅当官方变更时覆盖）
MEITU_INPAINT_TASK=/v1/InPainting/468520
MEITU_INPAINT_TIMEOUT_MS=120000
# 蒙版重绘区向外扩展像素（建议 5-10，避免紧贴物体轮廓产生补丁感）
MEITU_MASK_EXPAND_PX=6
# 蒙版边缘羽化像素（建议 4-8，硬边界生成后会有明显接缝）
MEITU_MASK_FEATHER_PX=6
# 腾讯云VOD AIGC服务（生图/生视频）
TENCENT_VOD_SID=your_tencent_vod_secret_id
TENCENT_VOD_SKEY=your_tencent_vod_secret_key
TENCENT_VOD_SUB_APP_ID=your_tencent_vod_sub_app_id
VITE_TEST_FRONTEND_URL=https://09beedesign-star.github.io/artx-test/
VITE_TEST_BACKEND_URL=https://artx-test.onrender.com
VITE_AI_API_BASE_URL=https://artx-test.onrender.com
VITE_API_BASE_URL=https://artx-test.onrender.com
VITE_AUTH_API_BASE_URL=https://artx-test.onrender.com
WALLYT_DOMAIN_URL=https://paycert.wepayez.com/pay/gateway
WALLYT_MCH_ID=your_wallyt_mch_id
WALLYT_SIGNATURE_KEY=your_wallyt_signature_key
WALLYT_NOTIFY_URL=https://artx-test.onrender.com/api/billing/wallyt/callback
WALLYT_WX_APP_ID=optional_wx_app_id
TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key
TENCENT_SMS_SDK_APP_ID=your_sms_sdk_app_id
TENCENT_SMS_SIGN_NAME=your_sms_sign_name
TENCENT_SMS_TEMPLATE_ID=your_sms_template_id
TENCENT_SMS_REGION=ap-guangzhou
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=ArtX <noreply@artxsd.com>
ADMIN_ALERT_EMAIL=ops@example.com
ALERT_WEBHOOK_URL=https://example.com/ops-webhook
BACKUP_LOCAL_DIR=/var/backups/artx
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SECRET=change_me_to_a_random_secret
BACKUP_REMOTE_BUCKET=

# 参数化擦字引擎（智能文案编辑的擦除通道之一，可选）
# 指向 image-text-replace 服务，提供 POST /api/inline/replace。
# 留空即关闭：该通道直接返回 null，擦字改由美图/佐糖/本地兜底承担，
# 行为与未接入引擎时完全一致，不影响任何既有功能。
# 本地开发建议写在 .env.local（已 gitignore），避免把地址提交进仓库。
TEXT_ENGINE_BASE_URL=
