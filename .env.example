###############################################################################
# ArtX 环境配置模板
#
# 用法：cp .env.example .env，然后填入真实值。
# 本文件与 .env 结构**完全同构**，逐节对照填写即可。
#
# ⚠️ 本仓库是 public 的。.env 已被 .gitignore 忽略，
#    任何真实密钥都不得写进本模板文件。
#
# 自检：node scripts/verify-model-env.mjs --file .env
#
# 密钥从哪来：
#   - 生产环境：服务器 /opt/artx-gray-backend/current/.env.gray
#   - 新申请：各供应商控制台（见各节注释）
###############################################################################


# ═════════════════════════════════════════════════════════════════════════════
# 1. 本地服务与跨域
# ═════════════════════════════════════════════════════════════════════════════
PORT=3001
VITE_API_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ═════════════════════════════════════════════════════════════════════════════
# 2. 腾讯云 VOD AIGC —— 图片生成的唯一通道【必填】
# ═════════════════════════════════════════════════════════════════════════════
# 来源：腾讯云控制台 → 访问管理 → API 密钥管理 / 云点播 → 应用管理
# 缺失后果：全站所有出图功能 100% 不可用，无任何兜底通道。
TENCENT_VOD_SID=your_tencent_vod_secret_id
TENCENT_VOD_SKEY=your_tencent_vod_secret_key
# SUB_APP_ID 不是密钥，可直接写入
TENCENT_VOD_SUB_APP_ID=1304471873


# ═════════════════════════════════════════════════════════════════════════════
# 3. 美图开放平台 —— 局部重绘 / 智能标注
# ═════════════════════════════════════════════════════════════════════════════
# 来源：美图 AI 开放平台控制台（doc/331 局部重绘接口）
# 缺失后果：擦字的美图通道失效，降级到佐糖 → 本地像素擦除。
# 变量名沿用通用的 ACCESS_KEY / SECRET_KEY，因为 server/meitu-client.ts
# 里写死了这两个名字，改名需同步改代码。
ACCESS_KEY=your_meitu_access_key
SECRET_KEY=your_meitu_secret_key
MEITU_FORMULA_BASE_URL=https://openapi.meitu.com
MEITU_INPAINT_TASK=/v1/InPainting/468520
MEITU_INPAINT_TIMEOUT_MS=120000
MEITU_MASK_EXPAND_PX=6
MEITU_MASK_FEATHER_PX=6


# ═════════════════════════════════════════════════════════════════════════════
# 4. 佐糖 PicWish —— 去背景 / 擦除 / 去水印 / 高清化 / 扩图
# ═════════════════════════════════════════════════════════════════════════════
# 来源：佐糖开放平台控制台
# 覆盖 7 项能力：背景生成、图像增强、擦除、去背景、去人像、去水印、扩图
# 缺失后果：AI 编辑的去背景/局部重绘不可用。
PICWISH_API_KEY=your_picwish_api_key
PICWISH_BASE_URL=https://techsz.aoscdn.com
PICWISH_TEMPLATE_BASE_URL=https://aw.aoscdn.com


# ═════════════════════════════════════════════════════════════════════════════
# 5. 中转站 bkeel —— 文本 / 多模态理解【文本部分必填】
# ═════════════════════════════════════════════════════════════════════════════
# 5.1 文本模型
# claude-opus-5 只在 token.bkeel.com 上存在，填 api.openai.com 会 404。
# 必须与 shared/text-models.ts 的 DEFAULT_TEXT_MODEL 一致。
AI_TEXT_API_KEY=your_text_api_key
AI_TEXT_BASE_URL=https://token.bkeel.com/v1
AI_TEXT_MODEL=claude-opus-5

# 5.2 多模态识图 / OCR（不做图片生成）
AI_IMAGE_API_KEY=your_image_api_key
AI_IMAGE_BASE_URL=https://token.bkeel.com/v1
# 留空即回落到 DEFAULT_IMAGE_MODEL_ID（vod-og25-sunburst-medium），推荐留空
AI_IMAGE_MODEL=
AI_IMAGE_REQUEST_TIMEOUT_MS=90000


# ═════════════════════════════════════════════════════════════════════════════
# 6. 参数化擦字引擎（可选）
# ═════════════════════════════════════════════════════════════════════════════
# 留空即关闭，擦字由美图 → 佐糖 → 本地兜底承担，功能不受影响。
# 生产服务器未部署该服务时务必留空，不要填 127.0.0.1。
TEXT_ENGINE_BASE_URL=
TEXT_ENGINE_TIMEOUT_MS=20000


# ═════════════════════════════════════════════════════════════════════════════
# 7. 数据目录
# ═════════════════════════════════════════════════════════════════════════════
# 本地填项目内路径；生产填 /var/lib/artx
ARTX_DATA_DIR=./.artx-data


# ═════════════════════════════════════════════════════════════════════════════
# 8. 支付 / 短信 / 邮件（生产必填，本地可留空）
# ═════════════════════════════════════════════════════════════════════════════
WALLYT_DOMAIN_URL=https://paycert.wepayez.com/pay/gateway
WALLYT_MCH_ID=your_wallyt_mch_id
WALLYT_SIGNATURE_KEY=your_wallyt_signature_key
WALLYT_NOTIFY_URL=https://backstage.artxsd.com/api/billing/wallyt/callback
WALLYT_WX_APP_ID=optional_wx_app_id

TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key
TENCENT_SMS_SDK_APP_ID=your_sms_sdk_app_id
TENCENT_SMS_SIGN_NAME=your_sms_sign_name
TENCENT_SMS_TEMPLATE_ID=your_sms_template_id
TENCENT_SMS_REGION=ap-guangzhou

RESEND_API_KEY=your_resend_api_key
RESEND_FROM=ArtX <noreply@artxsd.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
ADMIN_ALERT_EMAIL=ops@example.com
ALERT_WEBHOOK_URL=https://example.com/ops-webhook

ADMIN_SESSION_SECRET=change_me_to_a_random_secret

BACKUP_LOCAL_DIR=/var/backups/artx
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SECRET=change_me_to_a_random_secret
BACKUP_REMOTE_BUCKET=


# ═════════════════════════════════════════════════════════════════════════════
# 9. 前端构建期变量（VITE_ 前缀，会被打进产物，不可放密钥）
# ═════════════════════════════════════════════════════════════════════════════
VITE_TEST_FRONTEND_URL=https://backstage.artxsd.com
VITE_TEST_BACKEND_URL=https://backstage.artxsd.com
VITE_AI_API_BASE_URL=https://backstage.artxsd.com
VITE_AUTH_API_BASE_URL=https://backstage.artxsd.com
